# Free Frontier Subagents Credentials
# Copy to .env or ~/.agent_keys.env

# 1. NVIDIA NIM API Key (Free tier from https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here
# Optional multiple keys for automatic pool failover:
# NVIDIA_API_KEYS=nvapi-key1,nvapi-key2

# 2. OpenRouter API Key (Free models from https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# 3. Optional Google AI Studio Fallback (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy-your-gemini-key-here
